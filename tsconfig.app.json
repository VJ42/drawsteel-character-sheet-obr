{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases */
    "paths": {
      "@/logic/*": ["./src/forgesteel/logic/*"],
      "@/models/*": ["./src/forgesteel/models/*"],
      "@/enums/*": ["./src/forgesteel/enums/*"],
      "@/utils/*": ["./src/forgesteel/utils/*"],
      "@/data/*": ["./src/forgesteel/data/*"],
      "@/*": ["./src/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": [
    "src/forgesteel/**/*.test.ts",
    "src/forgesteel/**/*.test.tsx",
    "src/forgesteel/logic/classic-sheet",
    "src/forgesteel/logic/hero-sheet",
    "src/forgesteel/logic/playbook-sheets",
    "src/forgesteel/data/tip-data.ts"
  ]
}
